---
import ContactRequest from './ContactRequest';

export interface Listing {
  id: string;
  status: 'perdu' | 'trouve';
  docType: string;
  docTypeLabel: string;
  zone: string;
  date: string;
  idMask: string;
  challengeHint: string;
  notesPublic: string;
  demo: boolean;
}

interface Props {
  listing: Listing;
}

const { listing } = Astro.props;
const isFound = listing.status === 'trouve';
const dateFmt = new Date(listing.date + 'T12:00:00').toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<article
  class="rounded-xl border border-border bg-surface p-4 sm:p-5 flex flex-col gap-3 shadow-sm"
  data-listing-id={listing.id}
>
  <div class="flex flex-wrap items-start justify-between gap-2">
    <div>
      <h3 class="text-base font-semibold text-ink m-0">{listing.docTypeLabel}</h3>
      <p class="text-sm text-muted m-0 mt-0.5">{listing.zone}</p>
    </div>
    <div class="flex flex-wrap gap-1.5">
      <span
        class:list={[
          'inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium',
          isFound ? 'bg-green-50 text-success' : 'bg-amber-50 text-amber-900',
        ]}
      >
        {isFound ? 'Trouvé' : 'Perdu'}
      </span>
      {listing.demo && (
        <span class="inline-flex items-center rounded-full bg-sand px-2.5 py-0.5 text-xs font-medium text-ink">
          DÉMO / fictif
        </span>
      )}
    </div>
  </div>

  <dl class="grid grid-cols-2 gap-x-3 gap-y-2 text-sm m-0">
    <div>
      <dt class="text-muted text-xs">Date</dt>
      <dd class="m-0 font-medium">{dateFmt}</dd>
    </div>
    <div>
      <dt class="text-muted text-xs">Identifiant (masqué)</dt>
      <dd class="m-0 font-mono font-medium tracking-wide">{listing.idMask}</dd>
    </div>
  </dl>

  <p class="text-sm text-muted m-0">{listing.notesPublic}</p>

  <div class="rounded-lg border border-border bg-bg px-3 py-2 text-sm">
    <p class="m-0 text-xs text-muted uppercase tracking-wide">Indice de vérification (challenge)</p>
    <p class="m-0 mt-1 text-ink">{listing.challengeHint}</p>
    <p class="m-0 mt-1 text-xs text-muted">
      Utilisez cet indice en privé pour confirmer qu’il s’agit du bon document — sans divulguer le n° complet.
    </p>
  </div>

  <div class="flex flex-wrap items-center gap-2 pt-1 border-t border-border mt-1">
    <ContactRequest
      client:load
      listingId={listing.id}
      docTypeLabel={listing.docTypeLabel}
      zone={listing.zone}
      idMask={listing.idMask}
      status={listing.status}
    />
    <a
      href={`/contact?signaler=${listing.id}`}
      class="inline-flex items-center justify-center rounded-lg border border-border px-3 py-2 text-sm text-muted no-underline hover:bg-bg"
    >
      Signaler un abus
    </a>
  </div>
</article>
