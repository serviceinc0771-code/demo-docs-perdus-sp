---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Accueil' },
  { href: '/perdus', label: 'Perdus' },
  { href: '/trouves', label: 'Trouvés' },
  { href: '/signaler', label: 'Signaler' },
  { href: '/comment-ca-marche', label: 'Comment ça marche' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="border-b border-border bg-surface sticky top-0 z-40">
  <div class="mx-auto max-w-5xl px-4 py-3 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 min-w-0 no-underline text-ink">
      <span
        class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-cta text-white text-sm font-bold"
        aria-hidden="true"
      >SP</span>
      <span class="leading-tight">
        <span class="block text-sm font-semibold truncate">Documents perdus</span>
        <span class="block text-xs text-muted">San-Pédro · Démo</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-1" aria-label="Navigation principale">
      {links.map((l) => {
        const active = path === l.href || (l.href !== '/' && path.startsWith(l.href));
        return (
          <a
            href={l.href}
            class:list={[
              'px-3 py-1.5 rounded-md text-sm no-underline transition-colors',
              active ? 'bg-sand text-ink font-medium' : 'text-muted hover:bg-bg hover:text-ink',
            ]}
          >
            {l.label}
          </a>
        );
      })}
    </nav>

    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer rounded-md border border-border px-3 py-1.5 text-sm bg-surface">
        Menu
      </summary>
      <div class="absolute right-0 mt-2 w-56 rounded-lg border border-border bg-surface shadow-lg p-2 flex flex-col gap-1 z-50">
        {links.map((l) => (
          <a href={l.href} class="px-3 py-2 rounded-md text-sm text-ink no-underline hover:bg-bg">
            {l.label}
          </a>
        ))}
      </div>
    </details>
  </div>
</header>
