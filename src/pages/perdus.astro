---
import Layout from '../layouts/Layout.astro';
import ListingSearch from '../components/ListingSearch';
import listings from '../data/listings.json';

const perdus = listings.filter((l) => l.status === 'perdu');
---

<Layout title="Documents perdus — San-Pédro" description="Liste des documents déclarés perdus à San-Pédro (données fictives, démo).">
  <div class="mx-auto max-w-5xl px-4 py-8 sm:py-10">
    <h1 class="text-2xl sm:text-3xl font-bold m-0">Documents perdus</h1>
    <p class="text-muted mt-2 mb-6 max-w-2xl">
      Annonces partielles uniquement. Contact via formulaire + checklist — jamais de numéro WhatsApp
      listé en public. Données <strong>DÉMO / fictives</strong>.
    </p>
    <ListingSearch client:load listings={perdus} mode="perdu" />
  </div>
</Layout>
