---
import Layout from '../layouts/Layout.astro';
import SignalerForm from '../components/SignalerForm';
---

<Layout title="Signaler un document — San-Pédro">
  <div class="mx-auto max-w-xl px-4 py-8 sm:py-10">
    <h1 class="text-2xl sm:text-3xl font-bold m-0">Signaler</h1>
    <p class="text-muted mt-2 mb-6">
      Formulaire côté client uniquement (démo). À l’envoi : confirmation simulée + rappel de ce qui
      serait publié (données partielles seulement).
    </p>
    <div class="rounded-xl border border-border bg-surface p-5 sm:p-6">
      <SignalerForm client:load />
    </div>
  </div>
</Layout>
