---
import Layout from '../layouts/Layout.astro';
import ListingSearch from '../components/ListingSearch';
import listings from '../data/listings.json';

const trouves = listings.filter((l) => l.status === 'trouve');
---

<Layout title="Documents trouvés — San-Pédro" description="Liste des documents déclarés trouvés à San-Pédro (données fictives, démo).">
  <div class="mx-auto max-w-5xl px-4 py-8 sm:py-10">
    <h1 class="text-2xl sm:text-3xl font-bold m-0">Documents trouvés</h1>
    <p class="text-muted mt-2 mb-6 max-w-2xl">
      Si vous reconnaissez un document grâce au type, à la zone et au masque, demandez le contact
      après avoir accepté les règles anti-arnaque. Aucun paiement.
    </p>
    <ListingSearch client:load listings={trouves} mode="trouve" />
  </div>
</Layout>
