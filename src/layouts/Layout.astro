---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AntiScamBanner from '../components/AntiScamBanner.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Documents perdus San-Pédro",
  description = "Signaler ou retrouver un document perdu à San-Pédro (Côte d'Ivoire). Aucun échange d'argent. Site de démonstration.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-bg text-ink">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-surface focus:px-3 focus:py-2 focus:rounded focus:border focus:border-border"
    >
      Aller au contenu
    </a>
    <AntiScamBanner />
    <Header />
    <main id="contenu" class="flex-1 w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
